---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="住宅ローンを比較する">
  <section class="container" style="padding: 64px 24px; max-width: 640px;">
    <h1 style="font-size: 26px; font-weight: 900; margin-bottom: 16px;">住宅ローンを比較する</h1>
    <p style="font-size: 15px; color: var(--muted); line-height: 1.9;">
      ここに提携する住宅ローン比較サービスへのリンク（アフィリエイト）を設置します。
    </p>
  </section>
</Layout>
