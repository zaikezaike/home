---
import Layout from '../layouts/Layout.astro';
---

<Layout title="相談する">
  <section class="container" style="padding: 64px 24px; max-width: 640px;">
    <h1 style="font-size: 30px; font-weight: 900; margin-bottom: 16px;">相談する</h1>
    <p style="font-size: 15px; color: var(--muted); line-height: 1.9;">
      ここに、状況に応じた提携先（不動産会社・司法書士・税理士など）への紹介フォームや案内を追加していきます。
      現時点ではプレースホルダーページです。
    </p>
  </section>
</Layout>
